# AI mode settings for CiteFilter.
#
# Easiest: in the CiteFilter window press "Settings..." under AI assist, fill the fields and tick Save.
# By hand: copy this file to llm.env, fill it in, and put it in CiteFilter's settings folder:
#   Windows:  %APPDATA%\CiteFilter\llm.env
#   macOS:    ~/Library/Application Support/CiteFilter/llm.env
# (next to zotero_filter.py also works for the command line). No llm.env = no AI.
# Do not share llm.env: it holds your key.

# Any OpenAI-style chat endpoint. Examples:
#   OpenAI:          https://api.openai.com/v1
#   Ollama (local):  http://localhost:11434/v1
LLM_BASE_URL=

# Model name exactly as that provider calls it.
LLM_MODEL=

# API key. Leave empty for a local model such as Ollama.
LLM_API_KEY=
