#!/bin/zsh
# Opens the CiteFilter window. The app must stay in the folder that holds citefilter_ui.py.
cd "$(dirname "$0")/../../.." || exit 1
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"   # Finder-launched apps do not get the shell PATH (poppler lives here)
PY=/opt/miniconda3/bin/python3   # the Python that has scikit-learn, python-docx and Tk
[ -x "$PY" ] || PY=python3
exec "$PY" citefilter_ui.py
